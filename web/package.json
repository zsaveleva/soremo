    "build:static": "node scripts/build-static-data.mjs && VITE_STATIC=1 vite build && cp dist/index.html dist/404.html"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.62.0",
    "lucide-react": "0.460.0",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.28.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/geojson": "7946.0.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
